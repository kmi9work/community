# Шаблон deploy/.env. Реальные значения генерирует deploy/deploy.sh при первом
# запуске на сервере — в git секреты не попадают (.env в .gitignore).

# Версия Twenty (образ twentycrm/twenty). Меняется одной строкой = апгрейд ядра.
TAG=v2.58.0

# Публичный адрес инстанса (без слэша на конце)
SERVER_URL=https://kmi9site.ru

# Порт, который слушает Twenty на 127.0.0.1 (наружу не публикуется)
HOST_PORT=3100

PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=CHANGE_ME
PG_DATABASE_NAME=default

# openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME
# openssl rand -base64 48
APP_SECRET=CHANGE_ME
