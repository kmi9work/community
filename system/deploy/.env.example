# Шаблон system/deploy/.env. Настоящий файл генерирует deploy.sh при первом
# деплое на сервере (секреты остаются только там, chmod 600). Токены ботов
# вписываются руками, затем ./system/deploy/deploy.sh.

PUBLIC_URL=https://kmi9site.ru
HOST_PORT=3100
SECURE_COOKIES=true
TIMEZONE=Europe/Moscow

PG_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# Первый администратор CRM (создаётся, если учётных записей ещё нет)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME

# Боты: токен от @BotFather и от MAX для партнёров; секреты webhook генерируются
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=CHANGE_ME
